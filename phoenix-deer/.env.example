PORT=5050
MONGODB_URI=mongodb://user:password@localhost:27017/phoenix_deer?authSource=phoenix_deer

# Required only for the "Sync Garmin Connect" button (POST /api/import-garmin-connect).
# Uses the unofficial garmin-connect package, which logs in with your real
# Garmin account credentials. Does not work if the account has MFA enabled.
GARMIN_USERNAME=
GARMIN_PASSWORD=
