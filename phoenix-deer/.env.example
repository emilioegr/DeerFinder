PORT=5050
MONGODB_URI=mongodb://user:password@localhost:27017/phoenix_deer?authSource=phoenix_deer

# Random signing key for session cookies. Generate your own, don't reuse this:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# bcrypt hash of the admin password, used to log in at /admin. Generate with:
#   node scripts/hash-password.js
ADMIN_PASSWORD_HASH=
